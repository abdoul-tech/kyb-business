# Copier en back/.env puis compléter. back/.env est ignoré par git.
PORT=4000
MONGO_URL=mongodb://localhost:27017/kyb

# MinIO local (C:\minio) : identifiants root de l'instance
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kyb-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=

# 32 octets en base64 : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FILE_ENCRYPTION_KEY=

OPENAI_API_KEY=
LLM_MODE=live
LLM_MODEL_CLASSIFY=
LLM_MODEL_EXTRACT=
LLM_MODEL_GENERATE=

PDF_RENDER_DPI=200
MAX_FILE_BYTES=15728640
MAX_PAGES=30
WEB_ORIGIN=http://localhost:3000
