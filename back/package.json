{
  "name": "back",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prestart": "npm run build --workspace=@kyb/shared",
    "predev": "npm run build --workspace=@kyb/shared",
    "prebuild": "npm run build --workspace=@kyb/shared",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:smoke": "tsx smoke-test.ts",
    "llm:check": "tsx scripts/llm-check.ts",
