    "fixtures:realistic": "tsx scripts/generate-realistic-samples.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@kyb/shared": "0.0.0",
    "@napi-rs/canvas": "^1.0.9",
    "express": "^5.1.0",
    "file-type": "^22.1.1",
    "mongodb": "^7.6.0",
    "multer": "^2.4.0",
    "openai": "^7.23.0",
    "p-queue": "^9.3.3",
    "pdfjs-dist": "^6.3.289",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.30",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^5.0.2"
  }
